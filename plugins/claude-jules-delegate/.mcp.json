{
  "mcpServers": {
    "jules": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/jules-mcp.mjs"],
      "env": {
        "JULES_API_KEY": "${JULES_API_KEY}",
        "JULES_API_BASE_URL": "${JULES_API_BASE_URL}",
        "JULES_STATE_DIR": "${CLAUDE_PLUGIN_DATA}/state"
      }
    }
  }
}
