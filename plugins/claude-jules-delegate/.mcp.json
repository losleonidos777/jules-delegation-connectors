{
  "mcpServers": {
    "jules": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/jules-mcp.mjs"
      ],
      "env": {
        "JULES_API_KEY": "${JULES_API_KEY:-}",
        "JULES_API_BASE_URL": "${JULES_API_BASE_URL:-https://jules.googleapis.com/v1alpha}",
        "JULES_STATE_DIR": "${CLAUDE_PLUGIN_DATA}/state",
        "JULES_REQUEST_TIMEOUT_MS": "${JULES_REQUEST_TIMEOUT_MS:-30000}",
        "JULES_MAX_RETRIES": "${JULES_MAX_RETRIES:-3}"
      }
    }
  }
}
