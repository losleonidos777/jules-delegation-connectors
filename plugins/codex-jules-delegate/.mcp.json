{
  "mcpServers": {
    "jules": {
      "command": "node",
      "args": ["./bin/jules-mcp.mjs"],
      "cwd": ".",
      "env_vars": [
        "JULES_API_KEY",
        "JULES_API_BASE_URL",
        "JULES_STATE_DIR",
        "JULES_REQUEST_TIMEOUT_MS",
        "JULES_MAX_RETRIES"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 300
    }
  }
}
