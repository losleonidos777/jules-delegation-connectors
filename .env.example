# Create this in the Jules web app settings. Never commit the real value.
JULES_API_KEY=

# Optional API endpoint override.
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha

# Optional local state location.
JULES_STATE_DIR=.jules-orchestrator

# Optional REST reliability controls.
JULES_REQUEST_TIMEOUT_MS=30000
JULES_MAX_RETRIES=3
