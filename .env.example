# Google Jules API key. Create it from the Jules web app settings page.
JULES_API_KEY=

# Optional: override the Jules API base URL if Google changes alpha endpoints.
JULES_API_BASE_URL=https://jules.googleapis.com/v1alpha

# Optional: move local state outside the repository.
JULES_STATE_DIR=.jules-orchestrator

# Optional: MCP output framing. Keep "newline" for Claude/Codex. Use "content-length" for clients that require LSP-style framing.
MCP_FRAMING=newline
